 # .gitignore (cleaned)
 # Ignore virtual environment
 myenv/

 # Ignore Python cache and compiled files
 __pycache__/
 *.pyc

 # Ignore Jupyter checkpoints and common notebook artifacts
 *.ipynb_checkpoints
 *executed.ipynb

 # Notebook files (ignore all notebooks under colabNotebooks by default)
 colabNotebooks/*.ipynb
 colabNotebooks/OPENAI API KEY.docx

 # RAG-specific artifacts
 RAG/ko-sroberta-multitask/
 RAG/web-crawler/.venv/
 RAG/web-crawler/crawler-env/
 RAG/web-crawler/__pycache__/

 # Bytecode caches and other generated dirs
 .pytest_cache/
 dist/
 build/

 # OS files
 .DS_Store

 # End of cleaned .gitignore
