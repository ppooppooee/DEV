   "outputs": [
    {
     "data": {
      "text/plain": [
       "'안녕하세요! 저는 EXAONE 3.5으로, LG AI Research에서 개발된 인공지능 모델입니다. 따라서 나이에 대한 개념이 적용되지 않습니다. 제 역할과 기능은 사용자의 요청을 이해하고 안전하게 응답하는 데 초점을 맞추고 있습니다. 궁금한 점이 더 있으시다면 언제든지 말씀해 주세요!'"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "ai_response.content"
   ]
